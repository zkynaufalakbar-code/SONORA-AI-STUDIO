{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SONORA AI STUDIO",
  "version": "1.0.0",
  "identifier": "com.sonora.aistudio",
  "mainBinaryName": "SONORA-AI-Studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["sonora"],
        "name": "SONORA Audio Project",
        "description": "SONORA AI STUDIO Project File",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
